{
    "name": "archlens-for-vscode",
    "type": "module",
    "publisher": "ArchLens",
    "displayName": "ArchLens for VS Code",
    "description": "A Visual Studio Code extension that allows you to use ArchLens directly in your editor.",
    "version": "0.3.1",
    "engines": {
        "vscode": "^1.100.0"
    },
    "extensionDependencies": [
        "ms-python.python"
    ],
    "categories": [
        "Other",
        "Visualization"
    ],
    "homepage": "https://github.com/archlens",
    "repository": {
        "type": "git",
        "url": "https://github.com/archlens/ArchLens-VsCode-Extension"
    },
    "activationEvents": [],
    "imports": {
        "#app/*": {
            "types": "./src/*.ts",
            "default": "./dist/*.js"
        }
    },
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "archlens-in-vscode.openGraphView",
                "title": "ArchLens: Open Graph"
            },
            {
                "command": "archlens-in-vscode.setupArchLens",
                "title": "ArchLens: Setup ArchLens"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "filesWithDependencyTree",
                    "name": "Dependencies"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./ && vite build",
        "watch": "concurrently -n ext,web \"tsc --watch --preserveWatchOutput -p ./\" \"vite build --watch\"",
        "typecheck:webview": "tsc -p webview --noEmit"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/vscode": "~1.100.0",
        "concurrently": "^10.0.6",
        "cytoscape": "^3.34.4",
        "cytoscape-dagre": "^4.0.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.5"
    }
}
